APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
DATABASE_URL=sqlite:///./events.db
DEV_API_KEY=local-development-key
# Optional explicit machine keys (otherwise derived from DEV_API_KEY locally)
# TENANT_0_API_KEY=replace-with-tenant-0-key
# TENANT_1_API_KEY=replace-with-tenant-1-key
# TENANT_2_API_KEY=replace-with-tenant-2-key
# TENANT_3_API_KEY=replace-with-tenant-3-key
SEED_DEMO_TENANTS=true
# Keep false unless explicitly bootstrapping a local admin.  The password is
# never stored in source; it is hashed before insertion into SQLite.
# SEED_DEMO_USERS=true
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=password123
ACCESS_TOKEN_MINUTES=30
MAX_EVENT_RETRIES=3
RETRY_BASE_SECONDS=0.05
RETRY_MAX_SECONDS=5
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
RATE_LIMIT_LOCAL_FALLBACK=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
KAFKA_TOPIC=events
KAFKA_GROUP_ID=event-processing-workers
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_ENABLED=false
SCHEMA_REGISTRY_REQUIRED=false
OTEL_ENABLED=false
OTEL_SERVICE_NAME=event-processing-platform
# Set to console to export spans locally; production deployments can install
# their OTLP processor/exporter and set OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_EXPORTER_OTLP_ENDPOINT=
